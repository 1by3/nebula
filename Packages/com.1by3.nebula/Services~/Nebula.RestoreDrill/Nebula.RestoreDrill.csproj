<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>nebula-restore-drill</AssemblyName>
    <RootNamespace>Nebula.RestoreDrill</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DefineConstants>$(DefineConstants);NEBULA_SERVICE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Nebula.Services/Nebula.Services.csproj" />
  </ItemGroup>
</Project>
