<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DefineConstants>$(DefineConstants);NEBULA_SERVICE</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0649;CS0169</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <Compile Include="../../Runtime/Orchestrator/**/*.cs" />
    <Compile Include="../../Runtime/Gateway/**/*.cs" />
    <Compile Include="../../Runtime/Interest/**/*.cs" />
    <Compile Include="../../Runtime/ControlPlane/**/*.cs" />
    <Compile Include="../../Runtime/Protocol/**/*.cs" />
    <Compile Include="../../Runtime/Transport/**/*.cs" />
    <Compile Include="../../Runtime/Serialization/**/*.cs" />
    <Compile Include="../../Runtime/Core/CommandLine.cs;../../Runtime/Core/NetworkTime.cs;../../Runtime/Core/SyncState.cs;../../Runtime/Core/DatabaseUrl.cs" />
    <Compile Include="../../Runtime/Containers/ContainerRef.cs;../../Runtime/Containers/ContainerHint.cs;../../Runtime/Containers/EntityLocation.cs;../../Runtime/Containers/ContainerPlacement.cs" />
    <!-- The cross-worker call contract is pure C#: the same rules decide a call on a Unity worker and in the tests here. -->
    <Compile Include="../../Runtime/Worker/AuthorityCallContract.cs" />
    <!-- A worker keeping its control-plane registration true, and re-claiming what only it knows, after a control
         plane that came back empty (docs/control-plane-availability.md). Pure C# over the container registry, so
         the same decision code runs here and on a Unity worker. -->
    <Compile Include="../../Runtime/Worker/WorkerRegistration.cs" />
    <Compile Include="../../Runtime/Persistence/IPersistenceStore.cs;../../Runtime/Persistence/LocalPersistenceStore.cs;../../Runtime/Persistence/PersistedRecordJson.cs;../../Runtime/Persistence/PersistenceHost.cs;../../Runtime/Persistence/RemotePersistenceStore.cs" />
    <Compile Include="../../ThirdParty/LiteNetLib/**/*.cs" />
    <Compile Include="../../World/WorldGrid.cs" />
    <!-- A chunk grid's definition and its id derivation are pure C#: the gateway, the orchestrator and a
         matchmaker name a scope's chunks without Unity (docs/scoped-chunk-grids.md). -->
    <Compile Include="../../Runtime/World/ChunkGridDefinition.cs" />
    <EmbeddedResource Include="../../Runtime/Orchestrator/Resources/*.html" LogicalName="%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="Nebula.Services.Tests" />
    <InternalsVisibleTo Include="Nebula.Persistence.Benchmarks" />
    <!-- The restore drill (Tools/restore-drill.ps1) clears the gateway-session and scope claims through the
         same internal store interfaces the orchestrator uses, so the wipe it verifies is the real one. -->
    <InternalsVisibleTo Include="nebula-restore-drill" />
  </ItemGroup>
</Project>
