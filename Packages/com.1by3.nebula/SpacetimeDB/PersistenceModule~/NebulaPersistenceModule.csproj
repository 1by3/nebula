<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>wasi-wasm</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NebulaPersistenceModule</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.StartsWith('net10.')) Or '$(EXPERIMENTAL_WASM_AOT)' == '1'">
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
    <RestoreAdditionalProjectSources>https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-experimental/nuget/v3/index.json;https://api.nuget.org/v3/index.json;$(RestoreAdditionalProjectSources)</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SpacetimeDB.Runtime" Version="2.10.*" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.StartsWith('net10.'))">
    <PackageReference Include="Microsoft.DotNet.ILCompiler.LLVM" Version="10.0.0-*" />
    <PackageReference Include="runtime.$(NETCoreSdkPortableRuntimeIdentifier).Microsoft.DotNet.ILCompiler.LLVM" Version="10.0.0-*" />
  </ItemGroup>

  <!-- The spacetime CLI (2.10) looks for a wasm literally named StdbModule.wasm in the build output, whatever
       the project is called. This module keeps the descriptive AssemblyName and leaves an alias copy behind so
       `spacetime build` and `spacetime publish` find it. -->
  <Target Name="NebulaAliasWasmForCli" AfterTargets="Build;Publish">
    <PropertyGroup>
      <NebulaNativeWasmDir>$(MSBuildProjectDirectory)/bin/$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)/native/</NebulaNativeWasmDir>
    </PropertyGroup>
    <Copy SourceFiles="$(NebulaNativeWasmDir)$(AssemblyName).wasm" DestinationFiles="$(NebulaNativeWasmDir)StdbModule.wasm" Condition="Exists('$(NebulaNativeWasmDir)$(AssemblyName).wasm')" />
  </Target>

</Project>
